[Unit]
Description=Lightweight MySQL InnoDB Cluster Monitor
After=network-online.target mysqlrouter.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/mysql-cluster-monitor/env
ExecStart=/opt/mysql-cluster-monitor/venv/bin/python /opt/mysql-cluster-monitor/mysql_cluster_monitor_light.py --config /etc/mysql-cluster-monitor/config.json
Restart=on-failure
RestartSec=10
CPUQuota=5%
MemoryMax=150M
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/log/mysql-cluster-monitor /var/lib/mysql-cluster-monitor

[Install]
WantedBy=multi-user.target
